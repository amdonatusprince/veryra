# Shared by the contract deploy commands and the web app.
# Copy to .env at the repository root. Do not commit .env.

# testnet | mainnet | local
NEAR_NETWORK_ID=testnet
NEAR_NODE_URL=https://test.rpc.fastnear.com

# Account the wasm is deployed to. The web reads this contract.
NEAR_CONTRACT_ID=

# Account that calls `new` after deploy. Not a secret. Keys stay in the NEAR CLI keychain.
NEAR_PROTOCOL_OWNER=

# Veyra mock USDC. `faucet` mints 1,000 mUSDC to the caller once a day.
NEAR_USDC_TOKEN=
